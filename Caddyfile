# Caddy terminates TLS (auto Let's Encrypt cert) and reverse-proxies to the api container.
# Requires an A record for api.somedaytundra.com -> the Lightsail static IP, and inbound 80/443.

# {
#     email you@somedaytundra.com   # uncomment to get ACME expiry notices
# }

api.somedaytundra.com {
    reverse_proxy api:8000
}
