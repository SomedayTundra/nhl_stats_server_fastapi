# Copy to `.env` for local development (loaded automatically via python-dotenv).
# In production these are Fly.io secrets / fly.toml [env] entries (see DEPLOYMENT.md).

# MongoDB connection string. Local default is mongodb://localhost:27017/
# Production is the Atlas mongodb+srv://... URI (the database name is always nhl_stats).
MONGO_URI=mongodb://localhost:27017/

# Comma-separated list of browser origins allowed to call this API (CORS).
# Leave unset to fall back to the localhost dev origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost

# Optional regex for additional allowed origins, matched against the full origin. Production uses
# it for the client's Vercel preview deployments, e.g.
#   ^https://nhl-stats-client-react-[a-z0-9-]+-<vercel-team-slug>\.vercel\.app$
# CORS_ALLOW_ORIGIN_REGEX=

# When "true", a request for an un-cached finished season will shell out to
# app/scripts/update_mongodb.py and farm it from the NHL API before responding
# (can take minutes). Leave "false" in production; the DB is pre-loaded and the
# current season is farmed daily by .github/workflows/farm.yml.
ENABLE_ONDEMAND_FARMING=false

# Bind address for `python main.py` (uvicorn). The container overrides these on the CMD line.
HOST=0.0.0.0
PORT=8000
